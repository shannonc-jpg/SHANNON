{
  "name": "terrazzo-resine-video",
  "version": "1.0.0",
  "description": "Vidéo motion design — Système Terrazzo résine (2A Résine x Sherwin-Williams Resuflor)",
  "license": "UNLICENSED",
  "scripts": {
    "start": "remotion studio",
    "render:16x9": "remotion render Terrazzo-16x9 out/terrazzo-16x9.mp4 --concurrency=2",
    "render:9x16": "remotion render Terrazzo-9x16 out/terrazzo-9x16.mp4 --concurrency=2",
    "render": "npm run render:16x9 && npm run render:9x16",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@remotion/cli": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.5.4"
  }
}
